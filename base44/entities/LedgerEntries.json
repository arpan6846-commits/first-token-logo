{
  "name": "LedgerEntries",
  "type": "object",
  "title": "LedgerEntries",
  "description": "Immutable double-entry ledger with per-environment SHA-256 hash chain. Never updated or deleted. Indexes (enforced by the engine/worker as single writer): environment+seq (unique); environment+idempotencyKey (unique).",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "enum": [
        "simulation",
        "paper",
        "production"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "enum": [
        "DEPOSIT",
        "WITHDRAWAL",
        "TRANSFER",
        "BUY_FILL",
        "SELL_FILL",
        "FEE_ADJUSTMENT",
        "TAX_PROVISION",
        "TAX_RELEASE",
        "COMPOUNDING",
        "RECONCILIATION_ADJUSTMENT",
        "OPENING_BALANCE"
      ]
    },
    "memo": {
      "type": "string",
      "maxLength": 1000
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "amountPaise": {
            "type": "integer",
            "description": "Integer paise (1 INR = 100 paise)"
          }
        },
        "required": [
          "account",
          "amountPaise"
        ]
      },
      "minItems": 2
    },
    "refType": {
      "type": "string"
    },
    "refId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "LIVE",
        "BROKER",
        "PAPER_FEED",
        "SIMULATED",
        "HISTORICAL",
        "ESTIMATE",
        "MANUAL"
      ]
    },
    "prevHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "uid",
    "environment",
    "seq",
    "ts",
    "type",
    "lines",
    "idempotencyKey",
    "source",
    "prevHash",
    "hash"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
