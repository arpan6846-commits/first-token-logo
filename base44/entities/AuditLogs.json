{
  "name": "AuditLogs",
  "type": "object",
  "title": "AuditLogs",
  "description": "Append-only, hash-chained audit trail of every owner, system and AI action. Indexes (enforced by the engine/worker as single writer): ts.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "ts": {
      "type": "integer"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "prevHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "uid",
    "ts",
    "actor",
    "action",
    "prevHash",
    "hash"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
