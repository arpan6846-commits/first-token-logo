{
  "name": "CompoundingEvents",
  "type": "object",
  "title": "CompoundingEvents",
  "description": "Append-only compounding decisions (one per environment per date). Indexes (enforced by the engine/worker as single writer): environment+date (unique).",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "enum": [
        "simulation",
        "paper",
        "production"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cumEligibleNetPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "previousHighWaterPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "newProfitPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "reinvestPct": {
      "type": "number"
    },
    "reinvestedPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "toReservePaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "byVenue": {
      "type": "object"
    },
    "ledgerEntryId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPOUNDED",
        "NOTHING_ELIGIBLE"
      ]
    },
    "note": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    }
  },
  "required": [
    "uid",
    "environment",
    "date",
    "status"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
