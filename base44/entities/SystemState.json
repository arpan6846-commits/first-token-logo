{
  "name": "SystemState",
  "type": "object",
  "title": "SystemState",
  "description": "Kill switch, halt latches, reconciliation status, compounding high-water marks, worker heartbeat. Indexes (enforced by the engine/worker as single writer): uid (unique, single row \"system\").",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "killSwitch": {
      "type": "object"
    },
    "haltedUntil": {
      "type": "object"
    },
    "lastReconciliation": {
      "type": "object"
    },
    "compoundingHighWater": {
      "type": "object"
    },
    "lastCompoundingDate": {
      "type": "object"
    },
    "pendingSettings": {
      "type": "object"
    },
    "workerHeartbeatAt": {
      "type": "integer"
    },
    "workerVersion": {
      "type": "string"
    }
  },
  "required": [
    "uid",
    "killSwitch"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
