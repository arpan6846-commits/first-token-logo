{
  "name": "TradeFills",
  "type": "object",
  "title": "TradeFills",
  "description": "Venue-reported executions. venueTradeId unique per venue+environment. Only `reconciled` may change after insert. Indexes (enforced by the engine/worker as single writer): environment+venue+venueTradeId (unique); environment+orderId; environment+ts.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "enum": [
        "simulation",
        "paper",
        "production"
      ]
    },
    "orderId": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "enum": [
        "KITE",
        "COINDCX",
        "PAPER"
      ]
    },
    "venueTradeId": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "assetClass": {
      "type": "string",
      "enum": [
        "EQUITY",
        "CRYPTO"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "qty": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "feesPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "feesSource": {
      "type": "string",
      "enum": [
        "BROKER",
        "ESTIMATE"
      ]
    },
    "tdsPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "ts": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": [
        "LIVE",
        "BROKER",
        "PAPER_FEED",
        "SIMULATED",
        "HISTORICAL",
        "ESTIMATE",
        "MANUAL"
      ]
    },
    "reconciled": {
      "type": "boolean"
    },
    "settlementDate": {
      "type": "string",
      "format": "date"
    },
    "realizedPnlPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    },
    "costBasisPaise": {
      "type": "integer",
      "description": "Integer paise (1 INR = 100 paise)"
    }
  },
  "required": [
    "uid",
    "environment",
    "orderId",
    "venue",
    "venueTradeId",
    "side",
    "qty",
    "price",
    "ts",
    "source",
    "settlementDate"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
