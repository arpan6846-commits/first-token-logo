{
  "name": "JournalEntries",
  "type": "object",
  "title": "JournalEntries",
  "description": "Prop-desk written pre-trade/post-trade analysis, stock profile and psychology notes. Indexes (enforced by the engine/worker as single writer): environment+signalId; environment+orderId.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "enum": [
        "simulation",
        "paper",
        "production"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "PRE_TRADE",
        "POST_TRADE",
        "PROFILE",
        "PSYCHOLOGY"
      ]
    },
    "ts": {
      "type": "integer"
    },
    "symbol": {
      "type": "string"
    },
    "signalId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "sectorWhy": {
      "type": "string",
      "maxLength": 4000
    },
    "stockWhy": {
      "type": "string",
      "maxLength": 4000
    },
    "positionWhy": {
      "type": "string",
      "maxLength": 4000
    },
    "againstMePlan": {
      "type": "string",
      "maxLength": 4000
    },
    "whatHappened": {
      "type": "string",
      "maxLength": 8000
    },
    "rulesFollowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rulesBroken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profileScenario": {
      "type": "object"
    },
    "notes": {
      "type": "string",
      "maxLength": 8000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "WIN",
        "LOSS",
        "SCRATCH"
      ]
    }
  },
  "required": [
    "uid",
    "environment",
    "kind",
    "ts"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
