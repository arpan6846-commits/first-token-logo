{
  "name": "ReconciliationRecords",
  "type": "object",
  "title": "ReconciliationRecords",
  "description": "Append-only reconciliation results against venue balances, holdings and trades. Indexes (enforced by the engine/worker as single writer): environment+venue+ts.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Engine id (unique). Base44 assigns its own record id separately.",
      "minLength": 3,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "enum": [
        "simulation",
        "paper",
        "production"
      ]
    },
    "venue": {
      "type": "string",
      "enum": [
        "KITE",
        "COINDCX",
        "PAPER"
      ]
    },
    "ts": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "MATCHED",
        "MISMATCH",
        "ERROR"
      ]
    },
    "diffs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "importedFillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "uid",
    "environment",
    "venue",
    "ts",
    "status"
  ],
  "additionalProperties": false,
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
