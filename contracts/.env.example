# Copy to .env and fill in. Never commit .env.
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSCSCAN_API_KEY=

# Required on bscTestnet (all must differ from the deployer):
MULTISIG_ADDRESS=
KEEPER_ADDRESS=
RISK_REPORTER_ADDRESS=
# Optional (defaults to MULTISIG_ADDRESS):
TREASURY_ADDRESS=
# Seconds; testnet default 3600. Mainnet requires >= 172800.
TIMELOCK_DELAY_SECONDS=
# Comma-separated addresses allowed to deposit during the guarded launch.
BETA_DEPOSITORS=

# Real protocol addresses. Leave blank on testnet to deploy clearly-labelled mocks instead.
USDT_ADDRESS=
VENUS_MARKET_A=
VENUS_MARKET_B=
STABLE_POOL=
